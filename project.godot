; Engine configuration file.
config_version=5

[application]
config/name="Luces, Cámara, Horda"
config/description="Survivor-like de cine. Macacaweke Studio."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]
Data="*res://scripts/autoload/data.gd"
Loc="*res://scripts/autoload/loc.gd"
Save="*res://scripts/autoload/save.gd"
Controls="*res://scripts/autoload/controls.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Achievements="*res://scripts/autoload/achievements.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]
theme/custom_font="res://assets/fonts/ArchivoNarrow.ttf"

[input_devices]
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
